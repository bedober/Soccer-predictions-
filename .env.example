# Keep this token on the server. Never add it to Vite client variables.
TIKTOK_ACCESS_TOKEN=replace_with_a_user_oauth_access_token
PORT=3001

# Claude API
CLAUDE_API_KEY=replace_with_your_claude_api_key

# Social Login (OAuth)
GOOGLE_CLIENT_ID=replace_with_google_client_id
GOOGLE_CLIENT_SECRET=replace_with_google_client_secret
GITHUB_CLIENT_ID=replace_with_github_client_id
GITHUB_CLIENT_SECRET=replace_with_github_client_secret

# Session & Auth
SESSION_SECRET=replace_with_a_secure_random_string
CALLBACK_URL=http://localhost:3001/auth/callback
